<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodBeeDoo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Roboto:wght@300;500&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(to bottom, #f8e1a1, #e3c27e, #d2a968);
            font-family: 'Poppins', sans-serif;
        }
        .navbar {
            background-color: #8B5A2B;
            padding: 15px;
            font-weight: bold;
            font-size: 18px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .navbar a {
            color: #fff !important;
        }
        .heading-bar {
            background: url('https://img.freepik.com/free-photo/top-view-food-background-with-copy-space_23-2148818373.jpg') no-repeat center;
            background-size: cover;
            padding: 80px 10px;
            text-align: center;
            color: white;
            font-size: 40px;
            font-weight: bold;
            text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
        }
        .card {
            background: #fff3e6;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
            transition: transform 0.3s ease-in-out;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        }
        .add-to-cart-btn {
            background: linear-gradient(90deg, #D2691E, #A0522D);
            color: #fff;
            border: none;
            padding: 12px;
            font-weight: bold;
            width: 100%;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s ease-in-out;
        }
        .add-to-cart-btn:hover {
            background: linear-gradient(90deg, #A0522D, #8B4513);
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="#">FoodBeeDoo</a>
    </nav>
    <div class="heading-bar">
        <h2>Food Categories</h2>
    </div>
    <div class="container mt-5">
        <div class="row">
            {{#each items}}
            <div class="col-md-4 mb-4">
                <div class="card p-4">
                    <div class="card-body text-center">
                        <h5 class="card-title font-weight-bold">{{this.food_item}}</h5>
                        <label for="restaurantSelect" class="font-weight-bold mt-2">Select Restaurant:</label>
                        <select id="restaurantSelect-{{@index}}" class="form-control mb-3">
                            {{#each this.restaurants}}
                            <option value="{{restaurant}}" data-price="{{price}}">{{restaurant}} - ₹{{price}}</option>
                            {{/each}}
                        </select>
                        <button type="button" class="add-to-cart-btn" onclick="addToCart('{{this.food_item}}', '{{@index}}')">Add to Cart</button>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    <script>
        function addToCart(foodItem, index) {
            const selectElement = document.getElementById(`restaurantSelect-${index}`);
            const selectedOption = selectElement.options[selectElement.selectedIndex];
            const restaurant = selectedOption.value;
            const price = selectedOption.getAttribute('data-price');
            
            fetch('/users/cart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ food_item: foodItem, restaurant, price }),
            }).then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            }).then(data => {
                console.log('Success:', data);
            }).catch(error => {
                console.error('Error:', error);
            });
        }
    </script>
</body>
</html>
